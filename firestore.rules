rules_version = '2';

// ハースの Security Rules。設計は DATA_MODEL.md。
// 招待で登録し、メールアドレスの確認が済んだ利用者（member の印を持つ人）にだけ読み書きを許す。
// Workers は管理者として書くので、ここでは Workers だけが書く文書へのブラウザからの書き込みを禁止する
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.member == true
        && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return isMember() && request.auth.uid == uid;
    }

    function usernameOk(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }

    function profileTextOk(data) {
      return data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 30
        && data.bio is string && data.bio.size() <= 150;
    }

    // どちらかが相手をブロックしているか（3.5）。ブロックの文書は本人しか読めないが、ここからは調べられる
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    function postDoc(postId) {
      return get(/databases/$(database)/documents/posts/$(postId));
    }

    function usernameDoc(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    // プロフィール（3.1）。利用者全員が読める。本人は文字だけを書ける。status とアイコンは Workers が変える
    match /users/{uid} {
      allow read: if isMember();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'bio', 'iconPhotoId', 'status', 'createdAt'])
        && usernameOk(request.resource.data.username)
        && profileTextOk(request.resource.data)
        && request.resource.data.iconPhotoId == null
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        // 同じ書き込みで、ユーザー名の表に自分の名前を登録している
        && getAfter(usernameDoc(request.resource.data.username)).data.uid == uid;

      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'displayName', 'bio'])
        && usernameOk(request.resource.data.username)
        && profileTextOk(request.resource.data)
        && (request.resource.data.username == resource.data.username
          // ユーザー名を変えるときは、同じ書き込みで新しい名前を登録し、古い名前を消す
          || (getAfter(usernameDoc(request.resource.data.username)).data.uid == uid
            && !existsAfter(usernameDoc(resource.data.username))));
    }

    // ユーザー名の表（3.1）。ユーザー名が重ならないようにする
    match /usernames/{name} {
      allow read: if isMember();

      allow create: if isMember()
        && usernameOk(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;

      allow delete: if isMember()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != name;
    }

    // 本人だけの情報（3.1）。Workers が書く
    match /userPrivate/{uid} {
      allow read: if isSelf(uid);
      // 通知の一覧を開いた日時（読んだかどうかを決める）だけは、本人が書ける
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadNotificationsAt'])
        && request.resource.data.lastReadNotificationsAt == request.time;
    }

    // 写真の記録（3.3）。Workers だけが書く。持ち主と運営者だけが読める
    match /photos/{photoId} {
      allow read: if isMember() && (resource.data.owner == request.auth.uid || request.auth.token.admin == true);
    }

    // 投稿（3.4）。利用者全員が読める。止めたアカウントの投稿（hidden）は読めない。Workers だけが書く
    match /posts/{postId} {
      allow read: if isMember() && resource.data.hidden == false;

      // いいね（F-41）。文書の ID を自分の uid に限り、1 人 1 回にする
      match /likes/{likerId} {
        allow read: if isMember();
        allow create: if isSelf(likerId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && postDoc(postId).data.hidden == false
          && !blockedBetween(postDoc(postId).data.author, likerId);
        allow delete: if isSelf(likerId);
      }

      // コメント（F-42、F-43）。消せるのは、書いた人・投稿した人・運営者
      match /comments/{commentId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['author', 'text', 'createdAt'])
          && request.resource.data.author == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && postDoc(postId).data.hidden == false
          && !blockedBetween(postDoc(postId).data.author, request.auth.uid);
        allow delete: if isMember()
          && (resource.data.author == request.auth.uid
            || postDoc(postId).data.author == request.auth.uid
            || request.auth.token.admin == true);
      }
    }

    // フォロー（F-40）。文書の ID は「フォローする人_される人」
    match /follows/{followId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['follower', 'followee', 'createdAt'])
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.followee is string
        && request.resource.data.followee != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followee
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followee))
        && !blockedBetween(request.resource.data.followee, request.auth.uid);
      // 外せるのはフォローした人。ブロックしたときは、ブロックした人が相手からのフォローも外せる
      allow delete: if isMember()
        && (resource.data.follower == request.auth.uid
          || (resource.data.followee == request.auth.uid
            && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(resource.data.follower))));
    }

    // ブロック（F-80、F-81）。本人だけが読み書きでき、相手には分からない
    match /users/{uid}/blocks/{targetUid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && targetUid != uid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if isSelf(uid);
    }

    // 通知（3.7、F-95）。いいね・コメント・フォローをした人が、相手の通知として書く。
    // 本当にその操作をしたか（同じ書き込みで、いいね・コメント・フォローの文書ができているか）を確かめる
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSelf(uid);
      // 本人は自分の通知を消せる。操作した人は、取り消したとき（いいねを外す等）に自分が書いた通知を消せる
      allow delete: if isSelf(uid)
        || (isMember() && (resource == null || resource.data.actor == request.auth.uid));
      allow create: if isMember()
        && uid != request.auth.uid
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !blockedBetween(uid, request.auth.uid)
        && (
          (request.resource.data.type == 'follow'
            && notificationId == 'follow_' + request.auth.uid
            && request.resource.data.keys().hasOnly(['type', 'actor', 'createdAt'])
            && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)))
          || (request.resource.data.type == 'like'
            && request.resource.data.keys().hasOnly(['type', 'actor', 'postId', 'createdAt'])
            && notificationId == 'like_' + request.resource.data.postId + '_' + request.auth.uid
            && postDoc(request.resource.data.postId).data.author == uid
            && existsAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/likes/$(request.auth.uid)))
          || (request.resource.data.type == 'comment'
            && request.resource.data.keys().hasOnly(['type', 'actor', 'postId', 'commentId', 'createdAt'])
            && notificationId == 'comment_' + request.resource.data.commentId
            && postDoc(request.resource.data.postId).data.author == uid
            && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)).data.author == request.auth.uid)
        );
    }

    // メッセージの端末（3.8、F-100〜F-104）。公開鍵は利用者全員が読める（暗号化に使うため）。本人だけが書ける
    match /users/{uid}/devices/{deviceId} {
      allow read: if isMember();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['encPublicKey', 'signPublicKey', 'label', 'createdAt', 'lastSeenAt'])
        && request.resource.data.encPublicKey is map
        && request.resource.data.signPublicKey is map
        && request.resource.data.label is string && request.resource.data.label.size() <= 60
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if isSelf(uid);
    }

    // やり取り（3.8、F-60〜F-64）。ID は 2 人の uid を並べ替えてつないだもの。2 人だけが読み書きできる
    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    function conversationAfter(conversationId) {
      return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    match /conversations/{conversationId} {
      // まだないときも、自分が入る ID なら「ない」ことを確かめられる（ほかの人どうしのやり取りがあるかは分からない）
      allow read: if isMember()
        && (resource == null ? request.auth.uid in conversationId.split('_') : request.auth.uid in resource.data.members);
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'lastMessageAt', 'lastReadAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && conversationId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/users/$(otherMember(request.resource.data.members)))
        && !blockedBetween(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastReadAt is map
        && request.resource.data.lastReadAt.keys().hasOnly([request.auth.uid]);
      // 送ったとき（lastMessageAt）と、自分が読んだとき（lastReadAt の自分の分）だけを書き換えられる
      allow update: if isMember()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastReadAt'])
        && (request.resource.data.lastMessageAt == resource.data.lastMessageAt || request.resource.data.lastMessageAt == request.time)
        && request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.lastReadAt)
          || request.resource.data.lastReadAt[request.auth.uid] == request.time
          || request.resource.data.lastReadAt[request.auth.uid] == resource.data.lastReadAt.get(request.auth.uid, null));

      // メッセージ（4.3）。中身は暗号化してある。ブロックしている・されている相手には送れない（F-64）。
      // 取り消し（F-63）は、写真も消すため Workers が行う
      match /messages/{messageId} {
        allow read: if isMember() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create: if isMember()
          && request.auth.uid in conversationAfter(conversationId).members
          && !blockedBetween(conversationAfter(conversationId).members[0], conversationAfter(conversationId).members[1])
          && request.resource.data.keys().hasOnly(['v', 'sender', 'senderDevice', 'createdAt', 'epk', 'keys', 'iv', 'ct', 'photos', 'sig'])
          && request.resource.data.v == 1
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys is map
          && request.resource.data.keys.size() >= 1 && request.resource.data.keys.size() <= 30
          && request.resource.data.ct is string && request.resource.data.ct.size() <= 8000
          && request.resource.data.photos is list && request.resource.data.photos.size() <= 4
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/devices/$(request.resource.data.senderDevice));
      }
    }

    // 通報（3.9、F-82、F-83）。利用者が作り、運営者だけが読む。
    // メッセージの通報は、運営者には中身が読めないので、通報する人が自分の端末で読んだ内容を添える
    match /reports/{reportId} {
      allow read: if isMember() && request.auth.token.admin == true;
      // 運営者は、対応済みにする（または戻す）ことだけができる（F-91）
      allow update: if isMember() && request.auth.token.admin == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledAt', 'handledBy'])
        && request.resource.data.status in ['open', 'resolved']
        && request.resource.data.handledBy == request.auth.uid
        && request.resource.data.handledAt == request.time;
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['reporter', 'targetType', 'targetPath', 'targetUser', 'reason', 'detail', 'status', 'createdAt', 'messageContent'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment', 'user', 'message']
        && (request.resource.data.targetType == 'message') == ('messageContent' in request.resource.data)
        && (!('messageContent' in request.resource.data)
          || (request.resource.data.messageContent is string && request.resource.data.messageContent.size() <= 2000))
        && request.resource.data.targetPath is string && request.resource.data.targetPath.size() <= 200
        && request.resource.data.targetUser is string && request.resource.data.targetUser != request.auth.uid
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'privacy', 'other']
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }

    // ここに書いていない文書（招待・全体の設定など）は、ブラウザからは読み書きできない
  }
}
