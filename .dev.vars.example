# npm run dev で Workers が使う設定。.dev.vars にコピーする（Git には入らない）
# Firebase Emulator につなぐ（wrangler.jsonc の本番のプロジェクト ID を、開発中はこちらで上書きする）
FIREBASE_PROJECT_ID=demo-hearth
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
# 写真を見るための cookie に署名する鍵。開発用の値（本番は wrangler secret で別の乱数を設定する）
SESSION_SECRET=dev-only-session-secret-0123456789abcdef
