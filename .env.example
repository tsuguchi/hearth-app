# 画面が使う Firebase の設定。.env.local にコピーする（Git には入らない）
# このままで Firebase Emulator につながる
VITE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-hearth
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-hearth.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
# メッセージの画面を出すか（本番では法令の確認が済むまで false）
VITE_MESSAGES_ENABLED=true
